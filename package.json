{
  "name": "ekonomi-platform",
  "private": true,
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "dev": "node scripts/run-turbo.cjs dev --parallel",
    "build": "node scripts/run-turbo.cjs build",
    "lint": "node scripts/run-turbo.cjs lint",
    "test": "node scripts/run-turbo.cjs test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "pnpm --filter @ekonomi/db db:generate",
    "db:migrate": "pnpm --filter @ekonomi/db db:migrate",
    "db:seed": "pnpm --filter @ekonomi/db db:seed"
  },
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
